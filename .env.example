# Calendar feed URLs (Google Calendar secret iCal addresses)
VITE_CAL_PAPA=
VITE_CAL_PAPA_WORK=
VITE_CAL_DADDY=
VITE_CAL_WREN=
VITE_CAL_ELLIS=
VITE_CAL_FAMILY=

# Optional travel context (shows secondary time/weather for traveler in header)
# Example for Raleigh, NC:
# VITE_DADDY_TRAVEL_TIMEZONE=America/New_York
# VITE_DADDY_TRAVEL_LOCATION=Raleigh
# VITE_DADDY_TRAVEL_LAT=35.7796
# VITE_DADDY_TRAVEL_LON=-78.6382
VITE_DADDY_TRAVEL_TIMEZONE=
VITE_DADDY_TRAVEL_LOCATION=
VITE_DADDY_TRAVEL_LAT=
VITE_DADDY_TRAVEL_LON=

# CORS proxy URL for fetching calendar feeds from browser
VITE_CORS_PROXY_URL=

# News proxy Worker URL (Phase 5 — Cloudflare Worker at family-news-proxy.ops-unicorn.workers.dev)
VITE_NEWS_PROXY_URL=

# Supabase (Phase 5+) — get from https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Knuspr MCP credentials (for .mcp.json)
RHL_EMAIL=
RHL_PASS=
